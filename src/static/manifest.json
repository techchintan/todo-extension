{
  "name": "Todo Reminder",
  "description": "Quick-add todos, save pages and selections, and get Chrome notifications when due",
  "version": "1.1.0",
  "manifest_version": 3,
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Todo Reminder",
    "default_icon": "icon.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
